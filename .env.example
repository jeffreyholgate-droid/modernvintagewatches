# --- OpenAI: the only AI provider (server-side only) ---
OPENAI_API_KEY=
# Optional vision/text model overrides; Responses and Images API access is required.
OPENAI_TEXT_MODEL=gpt-6.2-sol
OPENAI_STUDIO_ANALYSIS_MODEL=gpt-6.2-sol
OPENAI_STUDIO_SCENE_MODEL=gpt-image-2.6-sunburst

# --- Required for Admin auth (server-side only) ---
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# --- Required for persistence in production (Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Required for Buy Now checkout (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Test-mode checkout only during recovery. Live payments are rejected until
# the database migration, pricing, sourcing/refund workflow and full test flow are validated.
CHECKOUT_ENABLED=false
PUBLIC_SITE_URL=https://modernvintagewatches.vercel.app

# --- eBay sourcing (server-side only) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production
EBAY_MARKETPLACE_ID=EBAY_GB

# --- Explicit local demos only; rejected on Vercel/in production ---
ALLOW_IN_MEMORY_DB=false
ALLOW_MOCK_EBAY=false

# --- Optional: if you want the frontend to call a different API base (rare). Leave blank for same domain.
VITE_API_BASE=

# Studio: optional server-to-server key (32+ random characters), never VITE-prefixed.
MVW_STUDIO_SERVICE_KEY=
# Extra exact HTTPS image hosts, comma separated. No wildcards.
STUDIO_IMAGE_HOSTS=
